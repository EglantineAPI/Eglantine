# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
server-executable

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Dragonfly runtime data, generated on first boot
/world/
/players/
/resources/

# Runtime state: generated worlds, player data, unpacked resource packs and the
# operator list are per-deployment and must not be committed.
/worlds/
/players/
/resources/
/operators.json
